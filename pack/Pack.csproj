<!-- Packs the assembly build.ps1 built into a NuGet package; it compiles nothing itself. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NuspecFile>BIMPlugins.AvalonEdit.nuspec</NuspecFile>
    <NuspecProperties>version=$(PackageVersion);output=$(BuildOutput);commit=$(RepositoryCommit)</NuspecProperties>
    <NuspecBasePath>$(MSBuildThisFileDirectory)</NuspecBasePath>
  </PropertyGroup>
</Project>
